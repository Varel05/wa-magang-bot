# =========================================================================
# Satu file .env ini dipakai untuk DUA hal sekaligus:
# 1) docker-compose.yml membaca file ini otomatis untuk mengisi ${...} (WAHA_API_KEY, TS_AUTHKEY, dst)
# 2) Service "bot" memuatnya sebagai env_file (GEMINI_API_KEY, ADMIN_PASSWORD, dst)
# Salin jadi ".env" (hapus ".example") lalu isi semuanya sebelum `docker compose up`.
# =========================================================================

# --- WAHA (WhatsApp self-hosted, menggantikan WhatsApp Cloud API / Meta) ---
# Bebas, buat string acak sendiri — melindungi endpoint WAHA (sendText, dst) dari akses tanpa izin.
WAHA_API_KEY=isi_string_acak_untuk_waha
# Bebas, buat string acak lain — dicek oleh api/webhook.js supaya cuma WAHA (bukan orang lain)
# yang bisa memicu endpoint webhook ini.
WAHA_WEBHOOK_SECRET=isi_string_acak_untuk_webhook_secret
# Nama session WAHA. "default" sudah cukup kalau cuma pakai 1 nomor WhatsApp.
WAHA_SESSION=default

# --- Hanya untuk mode HYBRID (WAHA lokal + domain tetap di Vercel) ---
# Lihat README-VERCEL-HYBRID.md. Kosongkan/abaikan kalau pakai mode full-lokal (README-WAHA.md).
# Domain Vercel kamu, TANPA trailing slash, mis. https://wa-magang-bot.vercel.app
VERCEL_APP_URL=isi_domain_vercel_kamu

# --- Tailscale ---
# Buat di https://login.tailscale.com/admin/settings/keys — pilih "Reusable" kalau container
# akan sering di-recreate, dan "Ephemeral" kalau device tidak perlu tampil terus di daftar tailnet.
TS_AUTHKEY=isi_tailscale_auth_key

# --- Gemini API ---
# Buat API key di https://aistudio.google.com/apikey
GEMINI_API_KEY=isi_gemini_api_key

# --- Telegram Bot ---
# Dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=isi_token_dari_botfather
# Bebas, buat sendiri (string acak), dipakai untuk verifikasi webhook Telegram
TELEGRAM_WEBHOOK_SECRET=magangbot_telegram_secret123

# --- Upstash Redis (untuk pesan perkenalan, riwayat percakapan, & FAQ custom) ---
# Buat database gratis di https://console.upstash.com, lalu salin dari tab "REST API"
UPSTASH_REDIS_REST_URL=isi_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=isi_upstash_redis_rest_token

# --- Panel Admin (/admin) ---
# Bebas, buat password sendiri yang kuat — melindungi riwayat chat & editor FAQ dari akses publik
ADMIN_PASSWORD=isi_password_admin_yang_kuat
