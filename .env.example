# URL API Langflow lokal Anda
# Biasanya: http://localhost:7860/api/v1/run/<FLOW_ID>
LANGFLOW_API_URL=http://localhost:7860/api/v1/run/GANTI_DENGAN_FLOW_ID

# API Key Langflow (jika flow Anda mewajibkan autentikasi)
LANGFLOW_API_KEY=

# Nomor admin (opsional) untuk menerima notifikasi bot online, format: 628xxxxxxxxxx
ADMIN_NUMBER=

# Jeda simulasi "mengetik" (ms) agar respon terasa natural, boleh diubah
TYPING_DELAY_MS=1200
