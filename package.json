{
  "name": "wa-magang-bot",
  "version": "2.0.0",
  "description": "Chatbot WhatsApp (via WAHA, self-hosted) & Telegram FAQ magang, jalan lokal di Docker + Tailscale",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/admin/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/admin/output.css --watch"
  },
  "dependencies": {
    "@google/genai": "^2.16.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
